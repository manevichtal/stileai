# StileAI dashboard environment. Copy to .env.local for local dev, or set these
# as project environment variables in Vercel. NEVER commit real values.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe for the browser; RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key. SERVER-SIDE ONLY. Never exposed to the browser,
# never committed. Used by the MCP-facing API routes (which authenticate by API
# key) and by first-time org onboarding.
SUPABASE_SERVICE_ROLE_KEY=

# Platform-owner ("master") accounts — comma-separated emails. These users get a
# read-only cross-tenant /admin view of every organization. Server-side only.
# Leave blank to disable the platform-owner area entirely.
PLATFORM_ADMIN_EMAILS=

# Deep inspection (optional AI second opinion). When set, StileAI sends the small
# share of "gray zone" requests the local checks can't classify with confidence to
# Anthropic's Claude Haiku for a second opinion. SERVER-SIDE ONLY. Leave blank to
# keep every tenant on the fully-local checks (deep inspection simply stays off).
ANTHROPIC_API_KEY=

# "Book a demo" email notifications (optional). The landing form always saves the
# lead to the demo_requests table; if a Resend API key is set it ALSO emails you.
# Get a key at resend.com. SERVER-SIDE ONLY. Leave blank to just collect leads in
# the database (view them in Supabase).
RESEND_API_KEY=
# Where demo requests are emailed. Defaults to manevichtal@gmail.com if unset.
DEMO_NOTIFY_EMAIL=
# Verified "from" sender. Until you verify your own domain in Resend, leave this
# blank and StileAI uses Resend's shared onboarding sender for notifications.
EMAIL_FROM=
