# StileAI dashboard environment. Copy to .env.local for local dev, or set these
# as project environment variables in Vercel. NEVER commit real values.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe for the browser; RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key. SERVER-SIDE ONLY. Never exposed to the browser,
# never committed. Used by the MCP-facing API routes (which authenticate by API
# key) and by first-time org onboarding.
SUPABASE_SERVICE_ROLE_KEY=
