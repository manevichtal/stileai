{
  "manifest_version": 3,
  "name": "StileAI: AI policy checkpoint",
  "version": "0.6.0",
  "description": "Checks what your team sends to ChatGPT, Claude, and Gemini against your company's AI policy before it leaves the browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://stileai.com/*",
    "https://www.stileai.com/*",
    "https://stileai.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "StileAI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": ["extractors.js", "interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://stileai.com/extension/connect*",
        "https://www.stileai.com/extension/connect*",
        "https://stileai.vercel.app/extension/connect*",
        "http://localhost:3000/extension/connect*"
      ],
      "js": ["connect.js"],
      "run_at": "document_end",
      "world": "ISOLATED"
    }
  ]
}
