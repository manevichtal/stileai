# Interlock configuration — copy to `.env` and fill in, or set these in your
# host's environment. Values shown are defaults.

# --- which store is the source of truth ---
# file = local policies.yaml + local audit log (dev)
# api  = your dashboard's HTTP API (production)
INTERLOCK_STORE=api

# stdio (local / Claude Desktop) or http (hosted)
INTERLOCK_TRANSPORT=http

# caller authentication for the HTTP transport. When set, every request to the
# MCP endpoint must send:  Authorization: Bearer <this value>
# Leave unset for local stdio use. REQUIRED when hosting the server publicly.
INTERLOCK_MCP_AUTH_TOKEN=replace-with-a-long-random-secret

# Optional host allow-list for the HTTP transport's DNS-rebinding protection.
# Comma-separated Host header values (e.g. stileai-mcp.onrender.com,api.example.com).
# If unset, host pinning is disabled (fine behind a proxy + the bearer token above).
INTERLOCK_MCP_ALLOWED_HOSTS=

# --- dashboard (api store) ---
INTERLOCK_DASHBOARD_URL=https://your-dashboard.example.com
INTERLOCK_API_KEY=replace-with-your-key
# how the key is sent. Default sends:  Authorization: Bearer <key>
# For a custom header instead, e.g.:  INTERLOCK_AUTH_HEADER=X-API-Key  and  INTERLOCK_AUTH_SCHEME=
INTERLOCK_AUTH_HEADER=Authorization
INTERLOCK_AUTH_SCHEME=Bearer

# refresh cadence + resilience
INTERLOCK_POLL_INTERVAL=30          # seconds between policy version checks
INTERLOCK_HTTP_TIMEOUT=10           # seconds per request
INTERLOCK_VERIFY_TLS=true
INTERLOCK_UNAVAILABLE_EFFECT=deny   # deny | require_approval  (NEVER set to allow)

# --- endpoint paths (override only if your dashboard differs) ---
INTERLOCK_EP_POLICIES=/api/policies
INTERLOCK_EP_POLICIES_VERSION=/api/policies/version
INTERLOCK_EP_AUDIT=/api/audit
INTERLOCK_EP_APPROVALS=/api/approvals
INTERLOCK_EP_APPROVAL_RESOLVE=/api/approvals/{id}/resolve

# --- file store only (when INTERLOCK_STORE=file) ---
# INTERLOCK_POLICIES=./policies.yaml
# INTERLOCK_AUDIT_LOG=./data/audit.log
